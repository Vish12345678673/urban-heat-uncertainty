{
    "dataset": "YCEO_UHI_Enhanced_ML_Clean_Daytime.csv",
    "features": [
        "NDVI",
        "Elevation",
        "Builtup",
        "Population",
        "Mean_Temp_C",
        "Mean_Monthly_Precip_mm",
        "Urban_LC_Fraction",
        "Water_LC_Fraction",
        "Vegetation_LC_Fraction"
    ],
    "target": "Annual_day",
    "spatial_block_size_degrees": 10,
    "test_size": 0.2,
    "random_state": 42,
    "model": "XGBoost",
    "model_parameters": {
        "n_estimators": 500,
        "learning_rate": 0.03,
        "max_depth": 6,
        "min_child_weight": 5,
        "subsample": 0.8,
        "colsample_bytree": 0.9,
        "reg_lambda": 1.0,
        "objective": "reg:squarederror",
        "eval_metric": "rmse",
        "random_state": 42,
        "n_jobs": -1,
        "tree_method": "hist"
    },
    "metrics": {
        "R2": 0.382648063859904,
        "RMSE": 0.6149841451453145,
        "MAE": 0.45095636404592027
    }
}